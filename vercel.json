{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/t/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/showcase", "destination": "/", "permanent": true },
    { "source": "/faq", "destination": "/", "permanent": true },
    { "source": "/questions", "destination": "/", "permanent": true },
    { "source": "/changelog", "destination": "/", "permanent": true },
    { "source": "/notes", "destination": "/", "permanent": true },
    { "source": "/updates", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/t/:token", "destination": "/api/t/:token" },
    { "source": "/sync", "destination": "/" },
    { "source": "/sync/:path*", "destination": "/" }
  ]
}
